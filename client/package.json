{
  "name": "xiquan-bathhouse-client",
  "version": "0.4.9",
  "private": true,
  "description": "溪泉洗浴管理系统客户端",
  "author": "溪泉洗浴",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "build": "npm run type-check && vite build",
    "test": "vitest run && npm run test:electron",
    "test:electron": "node --test electron/*.node-test.cjs build/*.node-test.cjs",
    "electron:install": "node node_modules/electron/install.js",
    "electron:build": "node build/windows-pack.cjs --targets win10-x64 --test-only",
    "electron:build:all": "node build/windows-pack.cjs --test-only"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "electron-updater": "6.8.9",
    "element-plus": "^2.11.0",
    "pinia": "^3.0.3",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.20",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "extract-zip": "2.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.xiquan.bathhouse",
    "productName": "溪泉洗浴管理系统",
    "electronUpdaterCompatibility": ">=2.16.0",
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.pqxqxy.xyz/updates/",
        "channel": "latest"
      }
    ],
    "artifactName": "Xiquan-Bathhouse-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "溪泉洗浴管理系统"
    }
  }
}
