[CmdletBinding()]
param([string]$EcsTarget='root@39.96.217.210',[switch]$ValidateOnly)
$ErrorActionPreference='Stop'
Set-Location -LiteralPath 'F:\溪泉洗浴系统'
if ($ValidateOnly) {
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $PSScriptRoot '01-签名并发布桌面更新.ps1') -PreflightOnly
    if ($LASTEXITCODE -ne 0) { throw '桌面本地校验失败，停止。' }
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $PSScriptRoot '02-发布网页静态页面.ps1') -ValidateOnly
    if ($LASTEXITCODE -ne 0) { throw '网页本地校验失败，停止。' }
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $PSScriptRoot '03-构建并发布安卓更新.ps1') -Mode validate
    if ($LASTEXITCODE -ne 0) { throw '安卓本地校验失败，停止。' }
    Write-Host '全部本地校验通过；未联网、签名或上传。'
    return
}
foreach ($name in @('01-签名并发布桌面更新.ps1','02-发布网页静态页面.ps1','03-构建并发布安卓更新.ps1')) {
    Write-Host ('正在执行：'+$name)
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $PSScriptRoot $name) -EcsTarget $EcsTarget
    if ($LASTEXITCODE -ne 0) { throw ($name+' 未完整验证，停止。请保留完整输出，不重跑旧版部署或恢复数据库。') }
}
Write-Host '三端公开发布校验通过。请在原软件检查更新、覆盖安装；不要卸载旧软件。'
