# 复制为 .env 后再修改。不要把 .env 上传到公开仓库。
COMPOSE_PROJECT_NAME=xiquan
TZ=Asia/Shanghai

# 域名必须先添加 A 记录并指向 ECS 公网 IP。
API_DOMAIN=CHANGE_ME_API_DOMAIN
ACME_EMAIL=CHANGE_ME_ACME_EMAIL

POSTGRES_DB=bathhouse
POSTGRES_USER=bathhouse
# 只使用字母、数字、下划线或短横线，避免 DATABASE_URL 转义问题。
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

SECRET_KEY=CHANGE_ME_SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY
# 独立审计签名密钥，首次启用后不可随意更换；留空时从 JWT_SECRET_KEY 派生。
# 已经产生 v2 审计记录后，切换本字段或 JWT_SECRET_KEY 前必须设计密钥迁移。
AUDIT_HMAC_KEY=
# 注册授权专用服务器密钥：至少 32 字节安全随机值。留空仅停用注册功能。
# 首次启用后私密备份，重复部署保留原值；不得打包到桌面/手机应用。
REGISTRATION_TOKEN_SECRET=
# 四种身份分别填写；这里仅公开占位示例，实际密码只保存在私有 .env。
# URL 密码中的保留字符必须百分号编码；隐藏输入用 psql \password。
# 保留既有 schema owner 名称；例子中的 bathhouse 必须按真实云库确认。
MAINTENANCE_DATABASE_URL=postgresql+psycopg://bathhouse:CHANGE_ME_OWNER_PASSWORD@postgres:5432/bathhouse
RUNTIME_DATABASE_URL=postgresql+psycopg://xiquan_app:CHANGE_ME_RUNTIME_PASSWORD@postgres:5432/bathhouse
RESET_DATABASE_URL=postgresql+psycopg://xiquan_reset:CHANGE_ME_RESET_PASSWORD@postgres:5432/bathhouse
RESET_BACKUP_DATABASE_URL=postgresql+psycopg://xiquan_backup:CHANGE_ME_BACKUP_PASSWORD@postgres:5432/bathhouse
# Compose 固定为 API 独占的命名卷；不能映射进 Nginx/下载目录。
RESET_PRIVATE_DIR=/var/lib/xiquan-reset
# 账号 UUID 不在示例中猜测/生成；维护前核对既有账号并显式传给 CLI。
# --administrator-id 可绑定额外高级管理员；激活不会停用或删除任何既有账号。
# 仅首次创建管理员时使用；管理员建成后该接口自动失效。
BOOTSTRAP_TOKEN=CHANGE_ME_BOOTSTRAP_TOKEN

# Electron 为 null；Capacitor 安卓/iOS 使用 localhost/capacitor Origin。手机网页版与 API 同域，不需要额外放行。
CORS_ORIGINS=null,http://localhost,https://localhost,capacitor://localhost

# 阿里云短信：先申请短信资质、签名和三个通知模板，审核通过后改为 1
SMS_ENABLED=0
SMS_ADMIN_PHONE=18631459666
SMS_SIGN_NAME=溪泉洗浴
SMS_STORED_CARD_TEMPLATE_CODE=SMS_REPLACE_ME
SMS_PASS_CARD_TEMPLATE_CODE=SMS_REPLACE_ME
SMS_ADMIN_TEMPLATE_CODE=SMS_REPLACE_ME
SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret

# 普通启动永远不迁移/播种；仅维护 profile 可显式 db upgrade。
RUN_MIGRATIONS=0
SEED_DEFAULTS=0

# ECS 本机备份目录；应定期把备份再复制到另一处或 OSS。
BACKUP_DIR=/opt/xiquan-backups
BACKUP_RETENTION_DAYS=30
