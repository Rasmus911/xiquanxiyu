server {
    listen 80;
    server_name __API_DOMAIN__;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __API_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__API_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__API_DOMAIN__/privkey.pem;
    ssl_session_cache shared:XiquanTLS:10m;
    ssl_session_timeout 1d;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 2m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location = /updates/latest.yml {
        alias /var/www/updates/latest.yml;
        default_type application/octet-stream;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location ~ ^/updates/desktop/(?<desktop_target>(?:win7|win10|win11)-(?:x86|x64))/latest\.yml$ {
        alias /var/www/updates/desktop/$desktop_target/latest.yml;
        default_type application/octet-stream;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }
    location ~ ^/updates/desktop/(?<artifact_target>(?:win7|win10|win11)-(?:x86|x64))/(?<desktop_artifact>Xiquan-Bathhouse-Setup-[0-9]+\.[0-9]+\.[0-9]+-(?:win7|win10|win11)-(?:x86|x64)\.exe(?:\.blockmap)?)$ {
        alias /var/www/updates/desktop/$artifact_target/$desktop_artifact;
        default_type application/octet-stream;
        autoindex off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    location /updates/desktop/ { return 404; }
    location ~ ^/releases/desktop/(?<policy_target>(?:win7|win10|win11)-(?:x86|x64))\.json$ {
        alias /var/www/releases/desktop/$policy_target.json;
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }
    location = /releases/desktop/delivery-index.json {
        alias /var/www/releases/desktop/delivery-index.json;
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }
    location /releases/desktop/ { return 404; }

    location /updates/ {
        alias /var/www/updates/;
        default_type application/octet-stream;
        autoindex off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /releases/client-policy.json {
        alias /var/www/releases/client-policy.json;
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    location = /app/index.html {
        root /var/www;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /app/version.json {
        root /var/www;
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location ^~ /app/assets/ {
        root /var/www;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /app/ {
        root /var/www;
        try_files $uri $uri/ /app/index.html;
    }

    location = /mobile/index.html {
        root /var/www;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /mobile/download-config.json {
        root /var/www;
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    location = /mobile/sw.js {
        root /var/www;
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Service-Worker-Allowed "/mobile/" always;
    }

    location = /mobile/manifest.webmanifest {
        root /var/www;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /mobile/downloads/ {
        alias /var/www/mobile/downloads/;
        default_type application/vnd.android.package-archive;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /mobile/ {
        root /var/www;
        try_files $uri $uri/ /mobile/index.html;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location /socket.io/ {
        proxy_pass http://api:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://api:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 75s;
    }
}
