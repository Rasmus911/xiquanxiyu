server {
    listen 80;
    server_name __API_DOMAIN__;

    client_max_body_size 2m;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location = /releases/client-policy.json {
        alias /var/www/releases/client-policy.json;
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # New desktop channels are HTTPS-only, even during HTTP bootstrap.
    location /updates/desktop/ { return 301 https://$host$request_uri; }
    location /releases/desktop/ { return 301 https://$host$request_uri; }

    location = /app/index.html {
        root /var/www;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /app/version.json {
        root /var/www;
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location ^~ /app/assets/ {
        root /var/www;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /app/ {
        root /var/www;
        try_files $uri $uri/ /app/index.html;
    }

    location = /mobile/index.html {
        root /var/www;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /mobile/download-config.json {
        root /var/www;
        default_type application/json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    location ^~ /mobile/downloads/ {
        alias /var/www/mobile/downloads/;
        default_type application/vnd.android.package-archive;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /mobile/ {
        root /var/www;
        try_files $uri $uri/ /mobile/index.html;
    }

    location /socket.io/ {
        proxy_pass http://api:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://api:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }
}
